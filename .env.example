# Database Connection
# Neon pooled connection string (used for the application runtime)
DATABASE_URL="postgresql://user:password@pooled-host/dbname?sslmode=require"
# Neon direct connection string (used for running migrations)
DIRECT_URL="postgresql://user:password@direct-host/dbname?sslmode=require"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"

# Email Notifications (Resend free tier)
RESEND_API_KEY="re_your_api_key"

# Application Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
